# ---------------------------------------------------------------------------
# Steve Gate — environment and secrets reference
# ---------------------------------------------------------------------------
# Local development: copy this file to `.dev.vars` (git-ignored) and fill it in.
# Wrangler loads `.dev.vars` automatically for `wrangler dev`.
#
# Production: never put secrets in wrangler.jsonc. `npm run cf:setup` pushes them to the
# Pages project and the companion Worker with `wrangler secret bulk`; by hand it is
#   wrangler pages secret put <NAME> --project-name steve-pay
# ---------------------------------------------------------------------------

# --- Non-secret configuration -------------------------------------------------
# Also set in wrangler.jsonc `vars`. These are safe to expose.
ENVIRONMENT=development                # development | production
GATEWAY_FEE_TOMAN=3000                 # default gateway fee in Toman (integer, never float)
UNIQUE_SUFFIX_DIGITS=4                 # 3 or 4 — length of the unique-amount suffix
TURNSTILE_SITE_KEY=                    # public Turnstile site key (registration + public invoice abuse)

# No BASE_URL. The platform reads its own origin from each incoming request, so the same
# build answers correctly on localhost, on the Pages project's *.pages.dev address, and on
# whatever custom domain is attached later. See src/core/origin.ts.

# --- SECRET: sessions ---------------------------------------------------------
# HMAC key for signing session cookies. Minimum 32 bytes of entropy.
#   node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- SECRET: API key pepper ---------------------------------------------------
# Server-side pepper mixed into API key hashes and webhook secret sealing.
# Changing this invalidates every stored API key hash, so treat it as permanent.
#   node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
API_KEY_PEPPER=

# --- SECRET: webhook signing root --------------------------------------------
# Root key used to derive per-endpoint webhook signing secrets (HKDF).
WEBHOOK_SECRET=

# --- SECRET: Telegram ---------------------------------------------------------
# Bot token from @BotFather and the chat that receives platform-level alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Secret token echoed back by Telegram in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# Set to "true" once the bot webhook is registered and /telegram/webhook is live.
TELEGRAM_WEBHOOK_ENABLED=false

# --- SECRET: Cloudflare Turnstile --------------------------------------------
TURNSTILE_SECRET=

# --- Optional: SMS source IP allowlist ---------------------------------------
# Comma-separated CIDR list. Empty means "allow any source IP" (API key still required).
SMS_IP_ALLOWLIST=

# --- Optional: operational switches ------------------------------------------
# When "true" invoice creation is refused for every merchant (maintenance mode).
MAINTENANCE_MODE=false

# --- Local-only convenience ---------------------------------------------------
# D1 database name used by the npm scripts.
D1_DATABASE_NAME=steve-pay
