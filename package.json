{
  "name": "steve-pay",
  "version": "1.0.0",
  "private": true,
  "description": "Steve Pay — a card-transfer payment gateway for Iranian banks, running entirely on Cloudflare's edge.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fonts": "node scripts/sync-fonts.mjs",
    "assets": "node scripts/build-assets.mjs",
    "predev": "npm run fonts && npm run assets",
    "dev": "wrangler dev -c wrangler.worker.jsonc --var ENVIRONMENT:development",
    "build": "node scripts/build-pages.mjs",
    "deploy": "npm run build && wrangler pages deploy dist-pages --no-bundle",
    "deploy:jobs": "wrangler deploy -c wrangler.worker.jsonc",
    "build:worker": "wrangler deploy -c wrangler.worker.jsonc --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply steve-pay --local",
    "db:migrate:remote": "wrangler d1 migrations apply steve-pay --remote",
    "db:seed:local": "wrangler d1 execute steve-pay --local --file seeds/0001_settings.sql",
    "db:seed:remote": "wrangler d1 execute steve-pay --remote --file seeds/0001_settings.sql",
    "cf:setup": "node scripts/cloudflare-setup.mjs",
    "cf:setup:test": "node scripts/cloudflare-setup.selftest.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "backup:export": "node scripts/export-backup.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/estedad": "^5.3.0",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260921.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "eslint": "^10.11.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.1"
  }
}
